# Questions the node installer answers for this service — NOT settings. `# kind:` says who answers.

# Port this service listens on. The node assigns it from the block 24680-24699.
# kind: derived
PORT=

# Interface to bind. `127.0.0.1` — this machine only; the tunnel brings the public address.
# kind: derived
SERVICE_BIND=

# Public address of this element (https://config.<zone> once a domain is connected). Empty — http://localhost:<port>.
# kind: derived
SERVICE_PUBLIC_URL=

# The site's shell door (/api/shell) — header and footer of the project, until 299-6 moves their data here.
# kind: derived
PROJECT_SHELL_URL=

# Where the links of the header lead (the site). The node installer gives it.
# kind: derived
PROJECT_SITE_URL=

# The key every element of the node presents to READ the settings. Writing is never given by the key.
# kind: secret
SETTINGS_SECRET=

# The sign-in service of the node: the architect session is checked there (GET <url>/api/session).
# kind: derived
AUTH_SERVICE_URL=

# The node registry (AGI-ITEMS-CONFIG/agi-items.json): which elements stand on this node — the links in the warning
# window before the menu or the sign-in is switched off.
# kind: derived
NODE_ITEMS_FILE=

# The node's connected domain (logs/domain.json): the public address of every element.
# kind: derived
NODE_DOMAIN_FILE=

# The core of the node (architect address): the deployments dashboard the "needs a deployment" message links to.
# kind: derived
ARCHITECT_URL=

# The node's design element (step 309): this service takes the project design (colours, fonts, type, shapes, block
# settings) from it over MCP (<url>/mcp) at start and on its signal, with SETTINGS_SECRET. Empty — no such element: own
# DESIGN-CONFIG applies.
DESIGN_SERVICE_URL=
